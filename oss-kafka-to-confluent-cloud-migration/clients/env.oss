# Source cluster (Apache Kafka on EC2), direct connection from the bastion:
# SASL_SSL with SCRAM-SHA-512, broker certificate verified against the workshop CA.
export KAFKA_ENV=oss
export OSS_BOOTSTRAP_SERVERS="kafka.oss-workshop.internal:9092"
export OSS_SASL_USERNAME="orders-app"
export OSS_SASL_PASSWORD="ChangeMe123!"
export OSS_SSL_CAFILE="$HOME/oss-workshop/ca.pem"
