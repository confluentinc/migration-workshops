# Gateway environment configuration
# Clients connect through the Gateway using SCRAM (passthrough to OSS Kafka before
# cutover, swap to Confluent Cloud after). The Gateway runs in k3s on the bastion and
# listens on localhost:9595.
export KAFKA_ENV=gateway
export GATEWAY_BOOTSTRAP_SERVERS="localhost:9595"
export GATEWAY_SASL_USERNAME="orders-app"
export GATEWAY_SASL_PASSWORD="ChangeMe123!"
