#!/bin/bash
# User data for the workshop's SOURCE cluster: open-source Apache Kafka ${kafka_version}
# (KRaft, single node) with one SASL_SSL / SCRAM-SHA-512 client listener, plus a read-only
# Jolokia agent so `kcp scan clusters --metrics jolokia` can collect broker metrics.
# Rendered by Terraform (instances.tf). Progress: /var/log/cloud-init-output.log.
set -euxo pipefail

KAFKA_HOME=/opt/kafka

dnf install -y java-17-amazon-corretto-headless

curl -fsSL --retry 5 -o /tmp/kafka.tgz \
  "https://archive.apache.org/dist/kafka/${kafka_version}/kafka_2.13-${kafka_version}.tgz"
echo "${kafka_sha512}  /tmp/kafka.tgz" | sha512sum -c -
mkdir -p $KAFKA_HOME
tar -xzf /tmp/kafka.tgz -C $KAFKA_HOME --strip-components=1

mkdir -p /opt/jolokia
curl -fsSL --retry 5 -o /opt/jolokia/jolokia-agent.jar \
  "https://repo1.maven.org/maven2/org/jolokia/jolokia-agent-jvm/${jolokia_version}/jolokia-agent-jvm-${jolokia_version}-javaagent.jar"
echo "${jolokia_sha256}  /opt/jolokia/jolokia-agent.jar" | sha256sum -c -
# kcp only issues `read` requests; refuse writes and MBean operations.
cat > /opt/jolokia/jolokia-access.xml <<'EOF'
<?xml version="1.0" encoding="utf-8"?>
<restrict>
  <commands>
    <command>read</command>
    <command>list</command>
    <command>search</command>
    <command>version</command>
  </commands>
</restrict>
EOF

useradd --system --no-create-home --shell /sbin/nologin kafka
mkdir -p /etc/kafka/tls /var/lib/kafka/data /var/log/kafka

# PEM keystore (private key + certificate chain) from Terraform's tls.tf. Kafka reads PEM
# natively, so no keytool/JKS conversion is needed.
cat > /etc/kafka/tls/broker-keystore.pem <<'EOF'
${trimspace(broker_key_pem)}
${trimspace(broker_cert_pem)}
${trimspace(ca_cert_pem)}
EOF
chmod 600 /etc/kafka/tls/broker-keystore.pem

cat > /etc/kafka/server.properties <<'EOF'
process.roles=broker,controller
node.id=1
controller.quorum.voters=1@localhost:9093

# CLIENT: the only listener reachable from the VPC. Clients, the Gateway, KCP and the
# Confluent Cloud cluster link all use it, verified against the workshop CA.
listeners=CLIENT://0.0.0.0:${kafka_port},INTERNAL://localhost:9099,CONTROLLER://localhost:9093
advertised.listeners=CLIENT://${kafka_host}:${kafka_port},INTERNAL://localhost:9099
listener.security.protocol.map=CLIENT:SASL_SSL,INTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
controller.listener.names=CONTROLLER
inter.broker.listener.name=INTERNAL

sasl.enabled.mechanisms=SCRAM-SHA-512
listener.name.client.sasl.enabled.mechanisms=SCRAM-SHA-512
listener.name.client.scram-sha-512.sasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required;
listener.name.client.ssl.keystore.type=PEM
listener.name.client.ssl.keystore.location=/etc/kafka/tls/broker-keystore.pem
listener.name.client.ssl.client.auth=none

log.dirs=/var/lib/kafka/data
num.partitions=3
auto.create.topics.enable=true
offsets.topic.replication.factor=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1
default.replication.factor=1
min.insync.replicas=1
EOF

# Format KRaft storage and create the workshop SCRAM user.
$KAFKA_HOME/bin/kafka-storage.sh format \
  -t "$($KAFKA_HOME/bin/kafka-storage.sh random-uuid)" \
  -c /etc/kafka/server.properties \
  --add-scram 'SCRAM-SHA-512=[name=${scram_username},password=${scram_password}]'
chown -R kafka:kafka /etc/kafka /var/lib/kafka /var/log/kafka

cat > /etc/systemd/system/kafka.service <<'EOF'
[Unit]
Description=Apache Kafka (KRaft) - OSS migration workshop source cluster
After=network-online.target
Wants=network-online.target

[Service]
User=kafka
Group=kafka
Environment="KAFKA_HEAP_OPTS=-Xms768m -Xmx768m"
Environment="LOG_DIR=/var/log/kafka"
Environment="KAFKA_OPTS=-javaagent:/opt/jolokia/jolokia-agent.jar=host=0.0.0.0,port=8778,discoveryEnabled=false,policyLocation=file:///opt/jolokia/jolokia-access.xml"
ExecStart=/opt/kafka/bin/kafka-server-start.sh /etc/kafka/server.properties
Restart=on-failure
LimitNOFILE=100000

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now kafka

for _ in $(seq 1 60); do
  if $KAFKA_HOME/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:9099 >/dev/null 2>&1; then
    break
  fi
  sleep 5
done
$KAFKA_HOME/bin/kafka-topics.sh --bootstrap-server localhost:9099 \
  --create --if-not-exists --topic orders --partitions 3 --replication-factor 1

echo "Source cluster ready: ${kafka_host}:${kafka_port}"
